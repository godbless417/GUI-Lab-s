// Функция обновления статусной строки
void MainWindow::updateStatus(const QString &message, bool isError)
{
    labelStatus->setText(message);
    
    QString style = isError
        ? "background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb;"
        : "background-color: #d4edda; color: #155724; border: 1px solid #c3e6cb;";
    
    labelStatus->setStyleSheet(
        "QLabel {"
        "  padding: 10px;"
        "  border-radius: 5px;"
        "  font-weight: 500;"
        "  " + style + 
        "}"
    );
}

// Функция валидации входной строки
bool MainWindow::validateInput(const QString &input)
{
    if (input.isEmpty()) {
        updateStatus("Ошибка: Введите текст для обработки!", true);
        return false;
    }
    
    // Проверка на наличие незакрытых скобок
    int openCount = 0;
    int closeCount = 0;
    
    for (const QChar &ch : input) {
        if (ch == '(') {
            openCount++;
        } else if (ch == ')') {
            closeCount++;
        }
    }
    
    if (openCount != closeCount) {
        updateStatus("Предупреждение: Количество открывающих и закрывающих скобок не совпадает!", true);
        // Не возвращаем false, так как обработка всё равно возможна
    }
    
    return true;
}

// ОСНОВНАЯ ФУНКЦИЯ: Удаление содержимого круглых скобок
// Алгоритм:
// 1. Проходим по строке символ за символом
// 2. При встрече '(' включаем режим пропуска
// 3. При встрече ')' выключаем режим пропуска
// 4. Все символы вне скобок копируем в результат
QString MainWindow::removeParenthesesContent(const QString &input)
{
    QString result;
    bool insideParentheses = false;
    int parenthesesCount = 0;
    
    for (int i = 0; i < input.length(); ++i) {
        QChar currentChar = input[i];
        
        if (currentChar == '(') {
            insideParentheses = true;
            parenthesesCount++;
            // Не добавляем '(' в результат
            continue;
        }
        
        if (currentChar == ')') {
            insideParentheses = false;
            parenthesesCount--;
            // Не добавляем ')' в результат
            continue;
        }
        
        // Если мы не внутри скобок, добавляем символ в результат
        if (!insideParentheses) {
            result += currentChar;
        }
    }
    
    // Обработка случая с лишними пробелами (опционально)
    // Удаляем двойные пробелы, которые могли возникнуть после удаления
    result.replace(QRegularExpression("\\s+"), " ");
    result = result.trimmed();
    
    return result;
}

// Альтернативная реализация с использованием QRegularExpression
// (более короткая, но менее наглядная для обучения)
QString removeParenthesesContentRegex(const QString &input)
{
    // Регулярное выражение: ищет любые символы между ( и ), включая сами скобки
    QRegularExpression re("\\([^()]*\\)");
    // Заменяем найденные совпадения на пустую строку
    QString result = input;
    result.replace(re, "");
    // Удаляем лишние пробелы
    result.replace(QRegularExpression("\\s+"), " ");
    return result.trimmed();
}

// Обработчик кнопки "Обработать"
void MainWindow::onProcessClicked()
{
    // Получаем входной текст
    QString inputText = textEditInput->toPlainText();
    
    // Валидация ввода
    if (!validateInput(inputText)) {
        if (inputText.isEmpty()) {
            return;
        }
    }
    
    // Обработка строки - удаление содержимого скобок
    // Используем основную реализацию (можно заменить на regex-версию)
    QString result = removeParenthesesContent(inputText);
    
    // Вывод результата
    if (result.isEmpty()) {
        lineEditResult->setText("(Пустая строка после обработки)");
        updateStatus("Обработка завершена. Все символы находились внутри скобок.");
    } else {
        lineEditResult->setText(result);
        
        // Подсчитываем количество удаленных скобочных групп
        int openCount = 0;
        for (const QChar &ch : inputText) {
            if (ch == '(') openCount++;
        }
        
        updateStatus(QString("Обработка завершена. Удалено %1 скобочных групп. Результат: \"%2\"")
                     .arg(openCount).arg(result.length() > 50 ? result.left(50) + "..." : result));
    }
}

// Обработчик кнопки "Очистить"
void MainWindow::onClearClicked()
{
    textEditInput->clear();
    lineEditResult->clear();
    updateStatus("Поля очищены. Введите новый текст.");
    textEditInput->setFocus();
}

// Обработчик кнопки "Выход"
void MainWindow::onExitClicked()
{
    QApplication::quit();
}
