// Функция обновления статусной строки
void MainWindow::updateStatus(const QString &message, bool isError)
{
    labelStatus->setText(message);
    
    QString style = isError
        ? "background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb;"
        : "background-color: #d4edda; color: #155724; border: 1px solid #c3e6cb;";
    
    labelStatus->setStyleSheet(
        "QLabel {"
        "  padding: 10px;"
        "  border-radius: 5px;"
        "  font-weight: 500;"
        "  " + style + 
        "}"
    );
}

// Функция управления состоянием кнопки обработки
void MainWindow::setProcessButtonState()
{
    bool enabled = !inputFilePath.isEmpty() && !outputFilePath.isEmpty();
    btnProcess->setEnabled(enabled);
    
    if (enabled) {
        btnProcess->setToolTip("Начать обработку файлов");
    } else {
        btnProcess->setToolTip("Сначала выберите входной и выходной файлы");
    }
}

// Функция отображения содержимого файла в списке
void MainWindow::displayFileContent(const QString &filePath, QListWidget *listWidget)
{
    listWidget->clear();
    
    QFile file(filePath);
    if (!file.exists()) {
        listWidget->addItem("Файл не существует");
        return;
    }
    
    if (!file.open(QIODevice::ReadOnly | QIODevice::Text)) {
        listWidget->addItem("Не удалось открыть файл для чтения");
        return;
    }
    
    QTextStream stream(&file);
#if QT_VERSION >= QT_VERSION_CHECK(6, 0, 0)
    stream.setEncoding(QStringConverter::Utf8);
#else
    stream.setCodec("UTF-8");
#endif
    
    int lineNumber = 0;
    while (!stream.atEnd()) {
        QString line = stream.readLine();
        listWidget->addItem(QString("[%1] %2").arg(++lineNumber, 3, 10, QChar('0')).arg(line));
    }
    
    file.close();
}

// ОСНОВНАЯ ФУНКЦИЯ: Удаление содержимого круглых скобок из строки
// Алгоритм: проходим по строке, копируем все символы вне скобок
QString MainWindow::removeParenthesesContent(const QString &line)
{
    QString result;
    bool insideParentheses = false;
    
    for (int i = 0; i < line.length(); ++i) {
        QChar currentChar = line[i];
        
        if (currentChar == '(') {
            insideParentheses = true;
            continue;  // Не добавляем '(' в результат
        }
        
        if (currentChar == ')') {
            insideParentheses = false;
            continue;  // Не добавляем ')' в результат
        }
        
        if (!insideParentheses) {
            result += currentChar;
        }
    }
    
    // Удаляем лишние пробелы, которые могли образоваться
    result.replace(QRegularExpression("\\s+"), " ");
    result = result.trimmed();
    
    return result;
}

// Функция обработки файлов (Вариант 9)
void MainWindow::processFiles(const QString &inputPath, const QString &outputPath,
                               QListWidget *inputList, QListWidget *outputList,
                               QString &longestLine, int &longestLineLength)
{
    // Очистка списков и переменных
    inputList->clear();
    outputList->clear();
    longestLine.clear();
    longestLineLength = 0;
    
    QFile inputFile(inputPath);
    QFile outputFile(outputPath);
    
    if (!inputFile.open(QIODevice::ReadOnly | QIODevice::Text)) {
        throw std::runtime_error("Не удалось открыть входной файл");
    }
    
    if (!outputFile.open(QIODevice::WriteOnly | QIODevice::Text)) {
        inputFile.close();
        throw std::runtime_error("Не удалось открыть выходной файл для записи");
    }
    
    QTextStream inputStream(&inputFile);
    QTextStream outputStream(&outputFile);
    
#if QT_VERSION >= QT_VERSION_CHECK(6, 0, 0)
    inputStream.setEncoding(QStringConverter::Utf8);
    outputStream.setEncoding(QStringConverter::Utf8);
#else
    inputStream.setCodec("UTF-8");
    outputStream.setCodec("UTF-8");
#endif
    
    int lineNumber = 0;
    int processedLines = 0;
    
    while (!inputStream.atEnd()) {
        QString originalLine = inputStream.readLine();
        lineNumber++;
        
        // Отображение исходной строки в списке
        inputList->addItem(QString("[%1] %2").arg(lineNumber, 3, 10, QChar('0')).arg(originalLine));
        
        // Обработка строки: удаление содержимого скобок
        QString processedLine = removeParenthesesContent(originalLine);
        
        // Если строка после обработки пустая, но исходная не была пустой,
        // возможно, вся строка была внутри скобок - оставляем пустую строку
        if (originalLine.isEmpty()) {
            processedLine = "";
        }
        
        // Запись в выходной файл
        outputStream << processedLine << Qt::endl;
        
        // Отображение обработанной строки в списке
        outputList->addItem(QString("[%1] %2").arg(lineNumber, 3, 10, QChar('0')).arg(processedLine));
        
        // Поиск самой длинной строки (только непустые строки)
        if (!processedLine.isEmpty() && processedLine.length() > longestLineLength) {
            longestLineLength = processedLine.length();
            longestLine = processedLine;
        }
        
        processedLines++;
    }
    
    inputFile.close();
    outputFile.close();
    
    // Обновление информации о количестве обработанных строк
    labelProcessedInfo->setText(QString("%1 строк").arg(processedLines));
    
    // Обновление информации о самой длинной строке
    if (longestLineLength > 0) {
        labelLongestLineInfo->setText(QString("Длина: %1 символов\n\"%2\"")
                                       .arg(longestLineLength)
                                       .arg(longestLine.length() > 100 ? longestLine.left(100) + "..." : longestLine));
    } else {
        labelLongestLineInfo->setText("Нет непустых строк после обработки");
    }
}

// Обработчик кнопки выбора входного файла
void MainWindow::onOpenInputFileClicked()
{
    QString fileName = QFileDialog::getOpenFileName(this,
        "Выберите входной текстовый файл",
        QDir::homePath(),
        "Текстовые файлы (*.txt);;Все файлы (*.*)");
    
    if (!fileName.isEmpty()) {
        inputFilePath = fileName;
        lineEditInputPath->setText(inputFilePath);
        updateStatus("Входной файл выбран: " + QFileInfo(fileName).fileName());
        
        // Отображаем содержимое входного файла
        displayFileContent(inputFilePath, listWidgetInputFile);
    } else {
        inputFilePath = "";
        lineEditInputPath->clear();
        updateStatus("Выбор входного файла отменен");
        listWidgetInputFile->clear();
    }
    
    setProcessButtonState();
}

// Обработчик кнопки выбора выходного файла
void MainWindow::onOpenOutputFileClicked()
{
    QString fileName = QFileDialog::getSaveFileName(this,
        "Выберите выходной текстовый файл",
        QDir::homePath() + "/output.txt",
        "Текстовые файлы (*.txt);;Все файлы (*.*)");
    
    if (!fileName.isEmpty()) {
        if (!fileName.endsWith(".txt", Qt::CaseInsensitive)) {
            fileName += ".txt";
        }
        outputFilePath = fileName;
        lineEditOutputPath->setText(outputFilePath);
        updateStatus("Выходной файл выбран: " + QFileInfo(fileName).fileName());
    } else {
        outputFilePath = "";
        lineEditOutputPath->clear();
        updateStatus("Выбор выходного файла отменен");
        listWidgetOutputFile->clear();
        labelLongestLineInfo->setText("");
        labelProcessedInfo->setText("0");
    }
    
    setProcessButtonState();
}

// Обработчик кнопки "Обработать файлы"
void MainWindow::onProcessClicked()
{
    // Проверка существования входного файла
    if (!QFile::exists(inputFilePath)) {
        updateStatus("Ошибка: Входной файл не существует!", true);
        return;
    }
    
    try {
        updateStatus("Обработка файлов...");
        QApplication::setOverrideCursor(Qt::WaitCursor);
        
        QString longestLine;
        int longestLineLength = 0;
        
        processFiles(inputFilePath, outputFilePath,
                     listWidgetInputFile, listWidgetOutputFile,
                     longestLine, longestLineLength);
        
        QApplication::restoreOverrideCursor();
        updateStatus(QString("Обработка завершена. Обработано строк: %1 | Самая длинная строка: %2 символов")
                     .arg(listWidgetInputFile->count())
                     .arg(longestLineLength));
        
    } catch (const std::exception &e) {
        QApplication::restoreOverrideCursor();
        updateStatus(QString("Ошибка при обработке: %1").arg(e.what()), true);
    } catch (...) {
        QApplication::restoreOverrideCursor();
        updateStatus("Неизвестная ошибка при обработке файлов!", true);
    }
}

// Обработчик кнопки "Очистить"
void MainWindow::onClearClicked()
{
    inputFilePath = "";
    outputFilePath = "";
    
    lineEditInputPath->clear();
    lineEditOutputPath->clear();
    
    listWidgetInputFile->clear();
    listWidgetOutputFile->clear();
    
    labelLongestLineInfo->clear();
    labelProcessedInfo->setText("0");
    
    btnProcess->setEnabled(false);
    
    updateStatus("Поля очищены. Выберите входной и выходной файлы");
}

// Обработчик кнопки "Выход"
void MainWindow::onExitClicked()
{
    QApplication::quit();
}
