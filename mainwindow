#include "mainwindow.h"
#include "GetPut.cpp"
#include "Task.cpp"
#include <QMessageBox>
#include <QApplication>

MainWindow::MainWindow(QWidget *parent)
    : QMainWindow(parent)
{
    setupUI();
}

MainWindow::~MainWindow() {}

void MainWindow::setupUI() {
    setWindowTitle("Лабораторная работа №11 - Вариант 9");
    resize(700, 600);
    
    // Центральный виджет
    QWidget* centralWidget = new QWidget(this);
    setCentralWidget(centralWidget);
    
    // Главный вертикальный layout
    QVBoxLayout* mainLayout = new QVBoxLayout(centralWidget);
    mainLayout->setContentsMargins(10, 10, 10, 10);
    mainLayout->setSpacing(10);
    
    // === ГРУППА ВВОДА ===
    QGroupBox* groupBoxInput = new QGroupBox("Входной массив");
    groupBoxInput->setStyleSheet(
        "QGroupBox { border: 2px solid #3498db; border-radius: 5px; "
        "margin-top: 10px; padding-top: 10px; }"
    );
    
    QVBoxLayout* inputLayout = new QVBoxLayout(groupBoxInput);
    
    QLabel* labelHint = new QLabel("Введите вещественные числа (каждое на новой строке):");
    labelHint->setWordWrap(true);
    inputLayout->addWidget(labelHint);
    
    textEditInput = new QTextEdit();
    textEditInput->setPlaceholderText("Пример:\n5.2\n12.8\n3.5\n8.1\n15.3\n7.6");
    textEditInput->setMinimumHeight(150);
    textEditInput->setStyleSheet(
        "QTextEdit { border: 1px solid #bdc3c7; border-radius: 5px; padding: 5px; }"
    );
    inputLayout->addWidget(textEditInput);
    
    mainLayout->addWidget(groupBoxInput);
    
    // === ГРУППА ВЫВОДА ===
    QGroupBox* groupBoxOutput = new QGroupBox("Результат");
    groupBoxOutput->setStyleSheet(
        "QGroupBox { border: 2px solid #2ecc71; border-radius: 5px; "
        "margin-top: 10px; padding-top: 10px; }"
    );
    
    QVBoxLayout* outputLayout = new QVBoxLayout(groupBoxOutput);
    
    listWidgetResult = new QListWidget();
    listWidgetResult->setMinimumHeight(200);
    listWidgetResult->setStyleSheet(
        "QListWidget { border: 1px solid #bdc3c7; border-radius: 5px; }"
    );
    outputLayout->addWidget(listWidgetResult);
    
    mainLayout->addWidget(groupBoxOutput);
    
    // === КНОПКИ ===
    QHBoxLayout* buttonLayout = new QHBoxLayout();
    buttonLayout->addStretch();
    
    pushButtonSolve = new QPushButton("Решить задачу");
    pushButtonSolve->setMinimumSize(120, 35);
    
    pushButtonClear = new QPushButton("Очистить");
    pushButtonClear->setMinimumSize(100, 35);
    pushButtonClear->setStyleSheet(
        "QPushButton { background-color: #f39c12; color: white; border: none; "
        "border-radius: 5px; font-weight: bold; padding: 5px; }"
        "QPushButton:hover { background-color: #e67e22; }"
        "QPushButton:pressed { background-color: #d35400; }"
    );
    
    pushButtonExit = new QPushButton("Выход");
    pushButtonExit->setMinimumSize(100, 35);
    
    buttonLayout->addWidget(pushButtonSolve);
    buttonLayout->addWidget(pushButtonClear);
    buttonLayout->addWidget(pushButtonExit);
    buttonLayout->addStretch();
    
    mainLayout->addLayout(buttonLayout);
    
    // === СТАТУСНАЯ СТРОКА ===
    labelStatus = new QLabel("Введите числа и нажмите 'Решить задачу'");
    labelStatus->setAlignment(Qt::AlignCenter);
    labelStatus->setMinimumHeight(35);
    labelStatus->setStyleSheet(
        "QLabel { padding: 8px; border-radius: 5px; background-color: #ecf0f1; "
        "color: #34495e; border: 1px solid #bdc3c7; }"
    );
    mainLayout->addWidget(labelStatus);
    
    // === ПОДКЛЮЧЕНИЕ СИГНАЛОВ ===
    connect(pushButtonSolve, &QPushButton::clicked, this, &MainWindow::onSolveClicked);
    connect(pushButtonClear, &QPushButton::clicked, this, &MainWindow::onClearClicked);
    connect(pushButtonExit, &QPushButton::clicked, this, &MainWindow::onExitClicked);
}

void MainWindow::onSolveClicked() {
    // Очистка списка результатов
    listWidgetResult->clear();
    
    // Ввод данных
    vector<double> originalArray = input(textEditInput);
    
    // Проверка на пустой ввод
    if (originalArray.empty()) {
        updateStatus("✗ Ошибка: Введите хотя бы одно число!", true);
        QMessageBox::warning(this, "Ошибка", "Введите хотя бы одно число!");
        return;
    }
    
    // Решение задачи
    bool conditionMet;
    vector<double> resultArray = task(originalArray, conditionMet);
    
    // Вывод результатов
    double firstElem = originalArray[0];
    double maxElem = findMax(originalArray);
    
    // Формирование информации о результате
    QString resultInfo;
    resultInfo += QString("Исходный вектор: ");
    for (size_t i = 0; i < originalArray.size(); ++i) {
        resultInfo += QString::number(originalArray[i], 'f', 3);
        if (i < originalArray.size() - 1) resultInfo += ", ";
    }
    resultInfo += "\n\n";
    resultInfo += QString("Первый элемент: %1\n").arg(firstElem, 0, 'f', 3);
    resultInfo += QString("Максимальный элемент: %1\n").arg(maxElem, 0, 'f', 3);
    resultInfo += "\n";
    
    if (conditionMet) {
        resultInfo += "✓ Условие: первый элемент НЕ является максимальным\n";
        resultInfo += QString("  Создан новый вектор (элементы > %1):\n").arg(firstElem, 0, 'f', 3);
        
        if (resultArray.empty()) {
            resultInfo += "  Нет элементов, больших первого";
        } else {
            for (size_t i = 0; i < resultArray.size(); ++i) {
                resultInfo += QString("  • %1\n").arg(resultArray[i], 0, 'f', 3);
            }
        }
        
        updateStatus(QString("√ Обработано %1 чисел. Найдено %2 элемента(ов) > %3")
                     .arg(originalArray.size())
                     .arg(resultArray.size())
                     .arg(firstElem, 0, 'f', 3));
    } else {
        resultInfo += "✗ Условие НЕ выполнено\n";
        resultInfo += "  Первый элемент является максимальным\n";
        resultInfo += "  Новая структура не создаётся";
        
        updateStatus(QString("√ Обработано %1 чисел. Условие не выполнено "
                             "(первый элемент = максимальный = %2)")
                     .arg(originalArray.size())
                     .arg(maxElem, 0, 'f', 3));
    }
    
    // Вывод в список
    QStringList lines = resultInfo.split('\n');
    for (const QString& line : lines) {
        listWidgetResult->addItem(line);
    }
}

void MainWindow::onClearClicked() {
    textEditInput->clear();
    listWidgetResult->clear();
    updateStatus("Введите числа и нажмите 'Решить задачу'");
    textEditInput->setFocus();
}

void MainWindow::onExitClicked() {
    QApplication::quit();
}

void MainWindow::updateStatus(const QString& message, bool isError) {
    labelStatus->setText(message);
    
    QString style;
    if (isError) {
        style = "background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb;";
    } else if (message.startsWith("√")) {
        style = "background-color: #d4edda; color: #155724; border: 1px solid #c3e6cb;";
    } else {
        style = "background-color: #ecf0f1; color: #34495e; border: 1px solid #bdc3c7;";
    }
    
    labelStatus->setStyleSheet(
        "QLabel { padding: 8px; border-radius: 5px; font-weight: 500; " +
        style + " }"
    );
}
